APP_ENV=development
FIRE_SMOKE_DATABASE_URL=sqlite:///./storage/flameeye.db
FIRE_SMOKE_API_HOST=127.0.0.1
FIRE_SMOKE_API_PORT=8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional people analytics tuning (WORK_ZONE uses normalized x1,y1,x2,y2 bounds).
CAMERA_SOURCE=0
CAMERA_ID=
API_BASE_URL=http://127.0.0.1:8000
PEOPLE_CONFIDENCE=0.45
CROWD_LIMIT=20
WORK_ZONE=0.05,0.05,0.95,0.95
ANALYTICS_INTERVAL=5
PERSON_MODEL_PATH=
DEMO_MODE=true

# Configure these only for the edge agent or notification integrations.
STORAGE_ROOT=./storage
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Optional edge notifications and incident media uploads.
TARGET_EMAIL=
SENDER_EMAIL=
SENDER_PASSWORD=
TARGET_PHONE=
CALLMEBOT_API_KEY=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
